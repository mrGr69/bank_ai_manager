# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Monobank personal API token from https://api.monobank.ua
MONOBANK_TOKEN=

# Optional: OpenAI-compatible LLM for unclear transactions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Postgres (Railway injects DATABASE_URL automatically)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# Public HTTPS origin on Railway, e.g. https://sentinel-xxxx.up.railway.app
PUBLIC_URL=

# Optional timezone
TZ=Europe/Kyiv
